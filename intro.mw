<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 3" layout="Heading 3">Integrating</Text-field></Title>
<Group labelreference="L383" drawlabel="true">
<Input><Text-field style="Normal" layout="Normal">Integration is implemented using the <Font style="Maple Input" executable="false">int</Font> command. Like <Font style="Maple Input" executable="false">diff</Font>, the command needs at least two arguments, the first being the function to be integrated and the second the integration variable. First, we give some examples of indefinite integration.</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L381" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
int(exp(I*beta*q), q);
f := x -&gt; sin(x)^3*cos(2*x)/(1-2*tan(x))^2;
simplify(int(f(x), x));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">KiheIyEiIiIiIkklYmV0YUc2IkYkLUkkZXhwRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliR0YnNiMqKF4jRiVGJUYmRiVJInFHRidGJUYl</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSJmR0YoZio2I0kieEdGKEYoNiRJKW9wZXJhdG9yR0YoSSZhcnJvd0dGKEYoKigtSSRzaW5HRiU2IzkkIiIkLUkkY29zR0YlNiMsJEY4IiIjIiIiLCZGP0Y/LUkkdGFuR0YlRjchIiNGQ0YoRihGKDcjRi4=</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L387" drawlabel="true">
<Input><Text-field style="Normal" layout="Normal">Note that indefinite integrals omit the &quot;arbitrary constant&quot; just as most tables do. Now, some definite integrals follow.</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L385" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">int(F(x), x = a..b);
int(sin(omega)^2, omega = 0..3*Pi);
A := int(exp(-a*x^2), x = -infinity..infinity);
assume(a&gt;0);
simplify(A);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
