<Group hide-input="false" labelreference="L162" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Thomas:= proc(a,b,c,d)
    local n, i, j, k, C, _D, x, X, l:

    #We define the new coeficients
    
    C[1]:=c[1]/a[1]:
    _D[1]:=d[1]/a[1]:

    n:=numelems(a):
 
    for i from 2 to n-1 do:
        C[i]:= c[i]/(a[i]-b[i]*C[i-1]):
    od;

    for k from 2 to n do:
        _D[k]:= (d[k]-b[k]*_D[k-1])/(a[k]-b[k]*C[k-1]):
    od;
    #Now we solve for x

    x[n]:= _D[n]:

    for j from 1 to n-1 do:
        x[n-j]:=_D[n-j]-C[n-j]*x[n-j+1]:
        #x[j]:=_D[j]-C[j]*x[j+1];
    od;

    #return convert(x,Vector);
    X:=convert([seq(x[l],l=1..n)],Vector);
end proc:
</Text-field>
</Input>
</Group>
