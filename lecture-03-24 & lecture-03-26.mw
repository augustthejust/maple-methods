<Group hide-input="false" labelreference="L4527" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">n := 2;
r := 4;
R := 7;
L := 25;
g := [x -&gt; 0, x -&gt; 0, x -&gt; 0, x -&gt; 0];
f := (x, y) -&gt; add((-1)^i*Heaviside(r^2-(x-R*cos(Pi*i/n))^2-(y-R*sin(Pi*i/n))^2), i = 0..2*n-1);
p[1] := plot3d(f(x, y), x = -L..L, y = -L..L, grid = [100, 100], shading = zhue, axes = boxed, style = patchcontour, labels = [x, y, `f(x, y)`]):
p[2] := PoissonSolve(30, f, g, L, 2):
display(Array([p[1], p[2]]));</Text-field>
</Input>
