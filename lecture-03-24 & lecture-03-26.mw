<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">PoissonSolve := proc(N, _f, g, L, choice)
    local Z, h, i, u, f, sys, w, sol, j, Data:
    Z := i -&gt; -L+2*L/(N+1)*i;
    h := evalf(Z(1)-Z(0));
    for i from 0 to N+1 do:
        u[N+1, i] := evalf(g[2](Z(i)));
        u[0, i] := evalf(g[4](Z(i)));
        u[i, 0] := evalf(g[1](Z(i)));
        u[i, N+1] := evalf(g[3](Z(i)));
    od:
    f := Array(0..N+1, 0..N+1, [seq([seq(evalf(_f(Z(i), Z(j))), i = 0..N+1)], j = 0..N+1)], datatype = float);
    sys := [seq(seq(Stencil[choice](h, i, j, u, f), i = 1..N), j = 1..N)];
    w := [seq(seq(u[i, j], i = 1..N), j = 1..N)];
    sol := LinearSolve(GenerateMatrix(sys, w));

    for i from 1 to N do:
        for j from 1 to N do:
            u[i, j] := sol[(j-1)*N+i]:
    od:
    od:

    Data := [seq([seq([Z(i), Z(j), u[i, j]], i = 0..N+1)], j = 0..N+1)]:
    surfdata(Data, axes = boxed, labels = [`x`, `y`, `u(x, y)`], shading = zhue, style = patchcontour);
end proc:</Text-field>
</Input>
</Group>
