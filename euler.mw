<Group labelreference="L881" drawlabel="true">
<Input><Text-field style="Text" layout="Normal">We now want to determine what the error is in each stencil. To do this, we need to rewrite each of them in the standard form <Equation executable="false" style="2D Math" input-equation="" display=""></Equation></Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L826" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">for j from 1 to 3 do:
    Stencils[j] := Stencils[j]*h+y[i]:
    Stencils[j] := (rhs-lhs)(Stencils[j]) = 0:
    print(Labels[j], Stencils[j]):
od:</Text-field>
</Input>
