<Group labelreference="L590" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal">From this we can see that the CN Stencil generates a system of linear equations for the values of the solution at the i+1 time step in terms of the values of the solution at the i time step.</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L208" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">sys:=[seq(seq(sys[jj][kk],kk=1..N),jj=1..M)];
future := [seq(seq(psi[jj,kk,i+1],kk=1..N), jj = 1..M)];
past := [seq(seq(psi[jj,kk,i],kk=1..N), jj = 1..M)];
P[Le] := GenerateMatrix(sys, future)[1];
_sys := map(x -&gt; rhs(x) = lhs(x), sys):
P[R] := GenerateMatrix(_sys, past)[1];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
