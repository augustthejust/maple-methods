<Group hide-input="false" labelreference="L595" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CN_general := psi[j, k, i + 1] - s*hbar*psi[j - 1, k, i + 1]*I/(4*m*h^2) + s*hbar*psi[j, k, i + 1]*I/(2*m*h^2) - s*hbar*psi[j + 1, k, i + 1]*I/(4*m*h^2) - s*hbar*psi[j, k - 1, i + 1]*I/(4*m*r^2) + s*hbar*psi[j, k, i + 1]*I/(2*m*r^2) - s*hbar*psi[j, k + 1, i + 1]*I/(4*m*r^2) - s*hbar*V[j][k]*psi[j, k, i + 1]*I/(4*m) = s*hbar*psi[j - 1, k, i]*I/(4*m*h^2) - s*hbar*psi[j, k, i]*I/(2*m*h^2) + s*hbar*psi[j + 1, k, i]*I/(4*m*h^2) + s*hbar*psi[j, k - 1, i]*I/(4*m*r^2) - s*hbar*psi[j, k, i]*I/(2*m*r^2) + s*hbar*psi[j, k + 1, i]*I/(4*m*r^2) + s*hbar*V[j][k]*psi[j, k, i]*I/(4*m) + psi[j, k, i];

</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L596" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">M := 50;
N:= 50;
t:=50;
L:=10;
tau:=10;
A:=sqrt(2/evalf(Pi));
f:=(x,y)-&gt;A*exp(-((x+5)^2+(y)^2))*exp(I*x); #Set up the initial condition
U:=(x,y)-&gt;piecewise(x&gt;0,5,x&lt;0,0);
X := a -&gt; -L+a*2*L/(M+1);
Y := b -&gt; -L+b*2*L/(N+1);
T := c -&gt; tau*c/t;
s := evalf(T(1)-T(0)); #Time step
h := evalf(X(1)-X(0)); #X Spacestep
r := evalf(Y(1)-Y(0)); #Y Spacestep
hbar:=1;
m:=hbar^2/2;



</Text-field>
</Input>
