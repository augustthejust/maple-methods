<Group labelreference="L591" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal"><Font encoding="UTF-8">So the problem of solving the time evolution of a given initial profile under a certain potential according to the Schr\303\266dinger Equation, has now reduced to solving a system of linear equations </Font><Equation executable="false" style="2D Math" input-equation="" display=""></Equation>at every time step.</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L209" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">for ii from 1 to t do:
    psi_future := LinearSolve(P[Le], P[R].psi_past): #Solve System of equations for future psi at every time step
    ZZ:=Transpose(Matrix([seq([seq(abs(convert(psi_future,'list')[l+m*N])^2,l=1..N)],m=0..M-1)])):
    psi_past := LinearAlgebra[Copy](convert(psi_future,Vector)):
    p[ii]:=listdensityplot(ZZ,smooth=true);
od:</Text-field>
</Input>
</Group>
