<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">plot3d(V(x, y), x = -10..10, y = -10..10, labels=['x','y','V(x,y)'],axes = boxed,labelfont=[TIMES, ROMAN, 24]);</Text-field>
