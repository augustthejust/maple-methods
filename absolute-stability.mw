<Group hide-input="false" hide-output="false" labelreference="L7298" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f := (x, y) -&gt; lambda*y;
ode := diff(y(x), x) = f(x, y(x));
