<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f := (x, y) -&gt; lambda*y;
E_def := E[i] = y[i]-y(x[i]);
Subs := [y(x+h) = y(x[i+1]), y(x) = y(x[i]), y_new = y[i+1], y_old = y[i], isolate(E_def, y[i]), subs(i = i+1, isolate(E_def, y[i]))];
for j from 1 to 5 do:
    EOM[j] := collect(simplify(subs(Subs$2, Stencil[j]-_Stencil[j])), [E[i+1], E[i]]):
od;
