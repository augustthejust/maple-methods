<Group labelreference="L169" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#To generate the stencil for this differential equation we will use the Generate Stencil Proceddure dfined in class</Text-field>
</Input>
</Group>
<Group labelreference="L170" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">GenerateStencil := proc(F, N, {orientation := center, stepsize := h, showorder := true, showerror := false})
    local vars, f, ii, Degree, stencil, Error, unknowns, Indets, ans, Phi, r, n, phi, i;

    Phi := convert(F, D);
    vars := op(Phi);
    n := PDEtools[difforder](Phi);
    f := op(1, op(0, Phi));
    if (nops([vars])&lt;&gt;1) then:
        r := op(1, op(0, op(0, Phi)));
    else:
        r := 1;
    fi:
    phi := f(vars);
    if (orientation = center) then:
        if (type(N, odd)) then:
            ii := [seq(i, i = -(N-1)/2..(N-1)/2)];
        else:
            ii := [seq(i, i = -(N-1)..(N-1), 2)];
        fi;
    elif (orientation = left) then:
        ii := [seq(i, i = -N+1..0)]:
    elif (orientation = right) then:
        ii := [seq(i, i = 0..N-1)]:
    fi;
    stencil := add(a[ii[i]]*subsop(r = op(r, phi)+ii[i]*stepsize, phi), i = 1..N);
    Error := D[r$n](f)(vars)-stencil;
    Error := convert(series(Error, stepsize, N), polynom);
    unknowns := {seq(a[ii[i]], i = 1..N)};
    Indets := indets(Error) minus {vars} minus unknowns minus {stepsize};
    Error := collect(Error, Indets, 'distributed');
    ans := solve({coeffs(Error, Indets)}, unknowns);
    if (ans = NULL) then:
        print(`Failure: try increasing the number of points in the stencil`);
        return NULL;
    fi:
    stencil := subs(ans, stencil);
    Error := convert(series(`leadterm`(D[r$n](f)(vars)-stencil), stepsize, N+20), polynom);
    Degree := degree(Error, stepsize);
    if (showorder) then:
        print(cat(`This stencil is of order `, Degree));
    fi:
    if (showerror) then:
        print(cat(`This leading order term in the error is `, Error));
    fi:
        convert(D[r$n](f)(vars) = stencil, diff);
end proc:</Text-field>
</Input>
</Group>
