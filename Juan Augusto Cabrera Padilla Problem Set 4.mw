<Group labelreference="L56" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">FTCS := proc(tau,N,M,d,c,f)  #Tau: final time, N+2:# of time points, M+2: # of Space points, f: initial data
    local s, h, XX, X, T, PlotOptions, Title, u_past, u_future, p, i, j:

    X := j -&gt; -1+j*2/(M+1); #Define the spatial points in the lattice
    T := i -&gt; tau*i/N;     #Define the temporal points in the lattice
    s := evalf(T(1)-T(0));   #Time step
    h := evalf(X(1)-X(0));   #Space step

    XX := Array(0..M+1, [seq(X(j), j=0..M+1)], datatype = float):  #Array with the space points

    u_past := Array(0..M+1, [seq(f(XX[j]), j = 0..M+1)], datatype = float): #Initial Condition
    p[0] := Frame[1](XX, u_past, s, h, T(0));

    for i from 1 to N do:
    u_future := Array(0..M+1, datatype = float):
    u_future[0] := 1:   #Boundary Condition
    u_future[M+1] := 0:  #Boundary Condition
    for j from 1 to M do:
        u_future[j] := Phi(u_past[j-1], u_past[j], u_past[j+1], h, s, d): #Calculate next time step values for each space point
    od:

    ArrayTools[Copy](u_future, u_past):  #We store only two rows at a time in the memory, which get updated after creating the corresponding frame

    p[i] := Frame[1](XX, u_past, s, h, T(i));

    od:

    display(convert(p, list), insequence = true):
end proc:

Frame[1] := proc(xdata, ydata, s, h, T)
    local Title, PlotOptions:
    Title := typeset(`timestep = `, evalf[2](s), `, spacestep = `, evalf[2](h), `, `, t = evalf[2](T));
    PlotOptions := axes = boxed, labels = [x, u(t, x)], legend = [&quot;FTCS&quot;], color = red;
    plot(Matrix([[xdata],[ydata]])^%T,title=Title,PlotOptions);
end proc:</Text-field>
</Input>
</Group>
