<Group labelreference="L1727" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">_A:= proc(M)
    local j,k,sys,X,A:
    for j from 1 to M do:
        sys[j] := U[j - 2](t)/h^4 - 4*U[j - 1](t)/h^4 + 6*U[j](t)/h^4 - 4*U[j + 1](t)/h^4 + U[j + 2](t)/h^4 =diff(U[j](t), t):
        sys[j]:=subs(centered_space_x0,centered_space_xf,U[0](t)=0,U[M+1](t)=0,sys[j]); 
  od:
    X := [seq(U[k](t), k = 1..M)]:
    A := GenerateMatrix(convert(sys, list), X)[1]:
    A:
end proc:
</Text-field>
</Input>
</Group>
