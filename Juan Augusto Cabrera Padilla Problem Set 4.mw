</Input>
</Group>
<Group labelreference="L94" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CN := proc(tau, N, M, f)
    local s, h, XX, u_past, u_future, Title, PlotOptions, p, A, P, i, j:

    #X := j -&gt; -1+j*2/(M+1);
    #T := i -&gt; tau*i/N;
    s := evalf(T(1)-T(0));
    h := evalf(X(1)-X(0));

    XX := Vector([seq(X(j), j = 1..M)], datatype = float): #Space points
    u_past := map(z -&gt; evalf(f(z)), XX):
    p[0] := Frame[3](XX, u_past, s, h, T(0)): #First fram with plot of Initial condition

    A := _A(M):
    P[1] := 1+s/2*A:
    P[2] := 1-s/2*A:

    for i from 1 to N do:
        u_future := LinearSolve(P[2], P[1].u_past): #Compute the next time sep values by solving the linear system 
        u_past := LinearAlgebra[Copy](u_future): 
        p[i] := Frame[3](XX, u_past, s, h, T(i)): #Frame with the plot at the corresponding time step
    od:
    display(convert(p, list), insequence = true);
    #display([seq(p[i], i=0..N)], insequence = true);
end proc:

Frame[3] := proc(xdata, ydata, s, h, T)
    local Title, PlotOptions:
    Title := typeset(`timestep = `, evalf[2](s), `, spacestep = `, evalf[2](h), `, `, t = evalf[2](T));
    PlotOptions := axes = boxed, labels = [x, u(t, x)], legend = [&quot;Crank-Nicolson&quot;], color = magenta;
    plot(Matrix([xdata, ydata]), title = Title, PlotOptions);
end proc:</Text-field>
</Input>
</Group>
