<Input><Text-field style="Text" bold="true" layout="Normal" alignment="centred"><Font bold="true">MATH 4503/6503 worksheet 3: analytic and numerical solutions of ODEs in Maple</Font></Text-field><Text-field style="Text" bold="true" layout="Normal" alignment="centred"></Text-field><Text-field style="Text" bold="true" layout="Normal" alignment="centred"><Font bold="false">Irfan Javed
<Font italic="true">January 19, 2026</Font></Font></Text-field><Text-field style="Text" bold="true" layout="Normal" alignment="centred"></Text-field><Text-field style="Text" bold="true" layout="Normal"><Font bold="false">The purpose of this worksheet is to introduce Maple's </Font><Font style="Maple Input" executable="false">dsolve</Font><Font bold="false"> command.</Font></Text-field>
</Input>
</Group>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1">Solving differential equations analytically</Text-field></Title>
<Group labelreference="L410" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;</Text-field>
</Input>
