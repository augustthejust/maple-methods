<Group labelreference="L248" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Now a procedure to compute the log of the error by comparing the numerical approximations with the analytical one</Text-field>
</Input>
</Group>
<Group labelreference="L249" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">LogError := proc(t0,y0,h,choice):
    local data, N, n:
    N:=t0/h:
    if choice=1 then:
        data:=ForwardEuler(t0,y0,N):
    elif choice=2 then:
        data:=Trapezoidal(t0,y0,N):
    else:
        false:
    fi:
    n:= nops(data):
    data := map(x -&gt; [x[1], log10(VectorNorm(x[2]-Vector[column]([sin(x[1])+cos(x[1]),cos(x[1])-sin(x[1])]),2))], data[2..n]): #Since y is a vector, to compute the error we calculate the norm of the difference between the anayltical vector and the numerical one
    data := evalf(data):
end proc:</Text-field>
</Input>
</Group>
