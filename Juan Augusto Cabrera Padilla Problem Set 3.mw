<Group labelreference="L569" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Now we create the procedures to solve the equation using Forward Euler and Trapezoidal stencils</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L237" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">ForwardEuler:= proc(t0,y0,N):
    local H, t, y, i:
    H:=evalf(t0/N):
    t[0]:=0:
    y[0]:=y0:
    for i from 1 to N do:
        t[i]:=t[i-1]+H:
        y[i]:=subs(h=H,P1).y[i-1]:
    od:
    [seq([t[i], y[i]], i = 0..N)]:
end proc:
</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false">Trapezoidal:= proc(t0,y0,N):
    local H, t, y, i:
    H:=evalf(t0/N):
    t[0]:=0:
    y[0]:=y0:
    for i from 1 to N do:
        t[i]:=t[i-1]+H:
        y[i]:=subs(h=H,P2).y[i-1]:
    od:
    [seq([t[i], y[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false"></Text-field>
</Input>
