<Group labelreference="L1202" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Now we setup our algorithm to solve with RK4</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L1080" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">rk4 := [k[1] = f(x[i], y[i]), k[2] = f(h/2 + x[i], h*k[1]/2 + y[i]), k[3] = f(h/2 + x[i], y[i] + h*k[2]/2), k[4] = f(h + x[i], h*k[3] + y[i]), y[i + 1] = y[i] + h*(k[1]/6 + k[2]/3 + k[3]/3 + k[4]/6)];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L1084" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">K:=[seq(unapply(rhs(rk4[n]), h, x[i], y[i], seq(k[m], m = 1..n-1)),n=1..5)];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L1082" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#Then Define a Procedure to find the Xi(h,x0) function for this problem when solving with RK4</Text-field>
</Input>
</Group>
<Group labelreference="L884" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">XiRK4:= proc(h,x0,K)
    local N, s, yh,y2h,i,j,k,n,m,x,l,k2:
    N:=round(x0/(2*h)):
    yh[0]:=y0:
    y2h[0]:=y0:
   
    for i from 1 to N do: 
        x[i] := x[i-1]+2*h:
        k[1] := K[1](2*h, x[i-1], y2h[i-1]):
        k[2] := K[2](2*h, x[i-1], y2h[i-1], k[1]):
        k[3] := K[3](2*h, x[i-1], y2h[i-1], k[1], k[2]):
        k[4] := K[4](2*h, x[i-1], y2h[i-1], k[1], k[2], k[3]):
        y2h[i] := K[5](2*h, x[i-1], y2h[i-1], k[1], k[2], k[3], k[4]):
    od:
    for j from 1 to 2*N do:
        x[j] := x[j-1]+h:
        k2[1] := K[1](h, x[j-1], yh[j-1]):
        k2[2] := K[2](h, x[j-1], yh[j-1], k2[1]):
        k2[3] := K[3](h, x[j-1], yh[j-1], k2[1], k2[2]):
        k2[4] := K[4](h, x[j-1], yh[j-1], k2[1], k2[2], k2[3]):
        yh[j] := K[5](h, x[j-1], yh[j-1], k2[1], k2[2], k2[3], k2[4]):
    od:
    s:=add((y2h[l]-yh[2*l])^2,l=0..N):
    s:= sqrt((1/(N+1))*s) : 
end proc:</Text-field>
</Input>
</Group>
