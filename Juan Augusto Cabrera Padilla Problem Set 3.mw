</Group>
<Group hide-input="false" labelreference="L119" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">derivative[1] := D(y)(x) = f(x, y(x));   #Here we make use of the Differential equation
for j from 2 to M do:
    derivative[j] := subs(derivative[1], convert(diff(derivative[j-1], x), D)): 
od;</Text-field>
