</Output>
</Group>
<Group labelreference="L1163" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#We repreat the same but now solving with Huen</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L885" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">huen:=[k[1]=f(x[i],y[i]),k[2]=f(x[i]+h,y[i]+h*k[1]),y[i+1]=y[i]+h*(k[1]/2+k[2]/2)];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L1164" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">K2:=[seq(unapply(rhs(huen[n]), h, x[i], y[i], seq(k[m], m = 1..n-1)),n=1..3)];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L886" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">XiHuen:= proc(h,x0)
    local N, s, yh,y2h,i,j,k,x,l:
    N:=round(x0/(2*h)):
    s:=0:
    yh[0]:=y0:
    y2h[0]:=y0:
    for i from 1 to N do:
        x[i] := x[i-1]+2*h:
        k[1] := K2[1](2*h, x[i-1], y2h[i-1]):
        k[2] := K2[2](2*h, x[i-1], y2h[i-1], k[1]):
        y2h[i]:=K2[3](2*h, x[i-1], y2h[i-1], k[1],k[2])
    od:
    for i from 1 to 2*N do:
        x[i] := x[i-1]+h:
        k[1] := K2[1](h, x[i-1], yh[i-1]):
        k[2] := K2[2](h, x[i-1], yh[i-1], k[1]):
        yh[i]:=K2[3](h, x[i-1], yh[i-1], k[1],k[2])
    od:
    
    s:=add((y2h[l]-yh[2*l])^2,l=0..N):
    s:= sqrt((1/(N+1))*s) :
end proc:</Text-field>
</Input>
</Group>
