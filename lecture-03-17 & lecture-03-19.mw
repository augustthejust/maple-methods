<Group labelreference="L27221" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">IsStable := proc(tau, N, M, d)
    local X, T, s, h:
    X := j -&gt; -1+j*2/(M+1);
    T := i -&gt; tau*i/N;
    s := evalf(T(1)-T(0));
    h := evalf(X(1)-X(0));
    if (2*s*d/h^2&lt;=1) then:
        &quot;this simulation is stable&quot;:
    else:
        &quot;this simulation will be unstable&quot;:
    fi:
end proc:</Text-field>
</Input>
</Group>
