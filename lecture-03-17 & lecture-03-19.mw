<Group labelreference="L24239" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CN := proc(tau, N, M, d, f)
    local X, T, s, h, XX, u_past, u_future, Title, PlotOptions, p, A, P, i, j:

    X := j -&gt; -1+j*2/(M+1);
    T := i -&gt; tau*i/N;
    s := evalf(T(1)-T(0));
    h := evalf(X(1)-X(0));

    XX := Vector([seq(X(j), j = 1..M)], datatype = float);
    u_past := map(z -&gt; f(z), XX);
    p[0] := Frame[3](XX, u_past, s, h, T(0)):

    A := _A(M, d, h):
    P[1] := 1+s/2*A:
    P[2] := 1-s/2*A:

    for i from 1 to N do:
        u_future := LinearSolve(P[2], P[1].u_past):
        u_past := LinearAlgebra[Copy](u_future):
        p[i] := Frame[3](XX, u_past, s, h, T(i)):
    od:
    display(convert(p, list), insequence = true);
end proc:

Frame[3] := proc(xdata, ydata, s, h, T)
    local Title, PlotOptions:
    Title := typeset(`timestep = `, evalf[2](s), `, spacestep = `, evalf[2](h), `, `, t = evalf[2](T));
    PlotOptions := axes = boxed, labels = [x, u(t, x)], legend = [&quot;Crank-Nicolson&quot;], color = magenta;
    plot(Matrix([xdata, ydata]), title = Title, PlotOptions);
end proc:</Text-field>
</Input>
</Group>
