<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">A := Matrix([seq([seq(alpha[n, m], m = 1..M)], n = 1..M)]);B := Vector[row]([seq(b[n], n = 1..M)]);C := Vector[column]([seq(c[n], n = 1..M)]);Butcher = subs(answer, map(x -&gt; if x = 0 then `` else x end if, Matrix([[C, A], [``, B]])));</Text-field>
</Input>
