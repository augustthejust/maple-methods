<Group hide-input="false" labelreference="L10" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">RK4Sol := proc(y0, N)    local h, x, y, i, k:    h := evalf(1/N):    x[0] := 0:    y[0] := y0:    for i from 1 to N do:        x[i] := x[i-1]+h:        k[1] := K[1](h, x[i-1], y[i-1]):        k[2] := K[2](h, x[i-1], y[i-1], k[1]):        k[3] := K[3](h, x[i-1], y[i-1], k[1], k[2]):        k[4] := K[4](h, x[i-1], y[i-1], k[1], k[2], k[3]):        y[i] := K[5](h, x[i-1], y[i-1], k[1], k[2], k[3], k[4]):    od:    [seq([x[i], y[i]], i = 0..N)]:end proc:</Text-field>
</Input>
</Group>
