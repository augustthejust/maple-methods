<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">forward_time := diff(u(t, x), t) = u(t+s, x)/s-u(t, x)/s;
backward_time := diff(u(t, x), t) = u(t, x)/s-u(t-s, x)/s;
