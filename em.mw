<Group hide-input="false" labelreference="L9" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CN := proc(tau, L, N, M, d, f)
    local X, T, s, h, XX, u_past, u_future, Title, PlotOptions, p, A, P, i, j, phi, psi, sys, vars, guess:
    X := j -&gt; L*(-1+j*2/(M+1));
    T := i -&gt; tau*i/N;
    s := evalf(T(1)-T(0));
    h := evalf(X(1)-X(0));
    X := j -&gt; L*(-1+j*2/(M+1));
    T := i -&gt; tau*i/N;
    s := evalf(T(1)-T(0));
    h := evalf(X(1)-X(0));
    XX := Array(0..M+1, [seq(X(j), j = 0..M+1)], datatype = float);
    psi := map(z -&gt; f(z), XX);
    p[0] := Frame(XX, psi, s, h, T(0)):
    for i from 1 to N do:
        phi := 'phi':
        phi[0], psi[0], psi[M+1], phi[M+1] := 0, 0, 0, 0;
        sys := [seq(master_CN(phi, psi, d, s, h, j), j = 1..M)];             
        vars := [seq(phi[j], j = 1..M)];
        guess := [seq(psi[j], j = 1..M)];
        phi := Newton[vector](sys, vars, guess, 1e-5):
        psi := Array(0..M+1, [0, op(phi), 0], datatype = float):
        p[i] := Frame(XX, psi, s, h, T(i)):
    od:
    display(convert(p, list), insequence = true);
end proc:
Frame := proc(xdata, ydata, s, h, T)
    local Title, PlotOptions:
    Title := typeset(`timestep = `, evalf[2](s),`, spacestep = `, evalf[2](h), `, `, t = evalf[2](T));
    PlotOptions := axes = boxed, labels = [x, u(t, x)], legend = [&quot;Crank-Nicolson&quot;], color = magenta;
    plot(Matrix([[xdata], [ydata]])^%T, title = Title, PlotOptions);
end proc:</Text-field>
</Input>
</Group>
