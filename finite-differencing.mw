<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">(u(conjugate(x)+h)-u(conjugate(x)))/h = lambda*u(conjugate(x));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LyomLCYtSSJ1RzYiNiMsJi1JKmNvbmp1Z2F0ZUclKnByb3RlY3RlZEc2I0kieEdGJyIiIkkiaEdGJ0YvRi8tRiY2I0YqISIiRi9GMEYzKiZJJ2xhbWJkYUdGJ0YvRjFGLw==</Equation></Text-field>
