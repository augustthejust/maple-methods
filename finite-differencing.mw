<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1">Higher order derivatives</Text-field></Title><Text-field style="Text" layout="Normal">Finite difference approximations to higher order derivatives can also be obtained. Repeatedly differencing approximations to lower order derivatives is a particularly simple approach. For example, <Equation executable="false" style="2D Math" input-equation="" display=""></Equation>and <Equation executable="false" style="2D Math" input-equation="" display=""></Equation> below give approximations to <Equation executable="false" style="2D Math" input-equation="" display=""></Equation>.</Text-field>
<Group hide-input="false" labelreference="L117" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">d[p] := (u, x) -&gt; (u(x+h)-u(x))/h;
d[m] := (u, x) -&gt; (u(x)-u(x-h))/h;
d[c] := (u, x) -&gt; (u(x+h)-u(x-h))/(2*h);
d[pm] := (u, x) -&gt; simplify((d[p](u, x)-d[p](u, x-h))/h);
d[mp] := (u, x) -&gt; simplify((d[m](u, x+h)-d[m](u, x))/h);
d[pm](u, x);
d[mp](u, x);</Text-field>
</Input>
