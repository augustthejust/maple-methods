<Group labelreference="L242" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">EulerSol2 := proc(y0, N, lambda, choice)
    local h, x, y, i:
    h := evalf(1/N):
    x[0] := 0:
    y[0] := y0:
    for i from 1 to N do:
        x[i] := x[i-1]+h:
        y[i] := stencil[choice](h, lambda, y[i-1]):
    od:
    [seq([x[i], y[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
</Group>
