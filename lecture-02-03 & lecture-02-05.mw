<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">epsilon := proc(y0, N, lambda, choice)
    local numerical, actual:
    numerical := EulerSol2(y0, N, lambda, choice)[N+1][2]:
    actual := y0*exp(lambda*1):
    evalf(abs(numerical-actual)):
end proc:</Text-field>
