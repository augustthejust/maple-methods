<Group hide-input="false" labelreference="L138" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">d3u:=collect(expand(-(2*u(x-2*h))/(5*h^3)+(5*u(x-h))/(8*h^3)+(2*u(x))/(5*h^3)-(7*u(x+h))/(8*h^3)+(11*u(x+3*h))/(40*h^3)-u(x+5*h)/(40*h^3)),h);</Text-field>
