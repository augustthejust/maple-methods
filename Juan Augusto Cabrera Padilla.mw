<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">err:=d3u-D3u;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSRlcnJHRigsLComIic3JEcjIiIiKUkiaEdGKCIiKEYxISIiKigiJz9AVkYxKUYzIiInRjFJInhHRihGMUY1KigiJyEpR09GMSlGMyIiJkYxKUY6IiIjRjFGNSooIidTaTpGMSlGMyIiJUYxKUY6IiIkRjFGNSooIiZnYCVGMSlGM0ZGRjEpRjpGREYxRjU3I0Yu</Equation></Text-field>
</Output>
