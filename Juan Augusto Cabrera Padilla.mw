<Group hide-input="false" labelreference="L43" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">d[p] := (u, x) -&gt; (u(x+h)-u(x))/h;
d[m] := (u, x)-&gt;(u(x)-u(x-h))/h;
d[c] := (u, x) -&gt; (u(x+h)-u(x-h))/(2*h);
d[mc]:=(u,x)-&gt;(d[c](u,x)-d[c](u,x-h))/h;
d[cmc]:=(u,x)-&gt;(d[mc](u,x+h)-d[mc](u,x-h))/(2*h);
d[pcmc]:=(u,x)-&gt;simplify((d[cmc](u,x+h)-d[cmc](u,x))/h);
d[pcmc](u,x);
</Text-field>
</Input>
