<Group labelreference="L144" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#The error, as seen in class, will be given by the difference between the approximation and the actual derivative, which for this case is given by the following expression</Text-field>
