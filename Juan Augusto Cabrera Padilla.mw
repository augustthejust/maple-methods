</Input>
</Group>
<Group hide-input="false" labelreference="L200" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">pde2:=simplify(subs(psi(t,rho,phi,z)=exp(i*m*phi)*exp(i*k*z)*exp(-i*omega*t)*f(rho),pde1));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L201" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">ode1:=isolate(pde2,diff(f(rho), rho, rho)*rho^2 + diff(f(rho), rho)*rho + i^2*f(rho)*((k^2 - omega^2)*rho^2 + m^2));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L203" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#WE find the general solutio  to this ODE by using dsolve and not intriducing initial conditions</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L96" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">sol1:=dsolve(ode1);</Text-field>
</Input>
