<Group hide-input="false" labelreference="L199" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">pde1:=diff(psi(t,rho,phi,z),t,t)-(1/rho)*diff(rho*diff(psi(t,rho,phi,z),rho),rho)-(1/rho^2)*diff(psi(t,rho,phi,z),phi,phi)-diff(psi(t,rho,phi,z),z,z)=0;expand(pde1);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L202" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
