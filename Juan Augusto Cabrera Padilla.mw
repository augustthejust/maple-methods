<Group hide-input="false" labelreference="L133" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">limit(abs(err/h^3),h=0,right);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LCQqJiImZ2AlIiIiKS1JJGFic0clKnByb3RlY3RlZEc2I0kieEc2IiIiJUYlRiU=</Equation></Text-field>
</Output>
