<Group hide-input="false" labelreference="L568" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Adams:= proc(n)    local unknowns,Error,derivative,vars,sys,sol,i,j,k:    unknowns:={seq(b[i], i=-1..n-1)}:    #These are our beta parameters    Error:= y(x+h)-y(x)-h*add(b[j]*f(x-j*h,y(x-j*h)),j=-1..<Font foreground="[200,0,200]" placeholder="true">n-1</Font>):    Error:=series(Error,h,n+2): #Expand the error as a series in powers of h    derivative[1]:=D(y)(x)=f(x,y(x)):
    for k from 2 to n+1 do:
        derivative[k] := subs(derivative[1], convert(diff(derivative[k-1], x), D)): #Use the fact that y'=f
    od:    Error:=subs(convert(derivative, list), Error):    vars:=indets(Error):    vars:=vars minus unknowns:    vars := vars minus {x, y(x)}:
    vars := vars union {O(h^(n+2))}:    Error := convert(Error, `+`):    Error := collect(Error, vars, distributed): #Collect the terms so that the coefficients of them only involve the unknowns aka the beta parameters    sys := {coeffs(Error, vars)}:    sys := sys minus {1}:
    sys := map(x -&gt; x = 0, sys):    sol := solve(sys):   #Solve the linear system of equations    return sol:end proc:    </Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false">#We can test the procedure, for example, with n=1 because, from the expression 4.1, we can see this case would correspond to the Trapezoidal method, meaning that the coefficients of f(x,y(x)) and f(x+h,y(x+h)) would have to be both equal to 1/2Adams(1);</Text-field>
</Input>
