<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#We define a procedure that implements the Trapezoidal algorithm given some intial conitions and an certain number of steps (taking into account that we're interested in the function in the interval [0,5])</Text-field>
</Input>
</Group>
<Group labelreference="L148" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Trapezoide:= proc(y10,y20,N)
    local h, x, y1,y2, i:
    h:=evalf(5/N):
    x[0] := 0:
    y1[0] := y10:
    y2[0]:=y20:
    for i from 1 to N do:
        x[i] := x[i-1]+h:
        y1[i] := trapezoide[1](h,y1[i-1],y2[i-1]):
        y2[i] := trapezoide[2](h,y1[i-1],y2[i-1]):
    od:
    [seq([x[i],y1[i],y2[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
</Group>
