<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">We define our procedure Solver </Text-field></Title>
<Group labelreference="L560" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Solver0:=proc(f,n,N)    local h,x,y,z,i,j,k,l,m,d:    h:=1/N:    x[0]:=0:    y[0]:=1:    for i from 1 to N do:        x[i]:=x[i-1]+h:        z[0]:=unapply(f(Y),Y): #Initialize a list that will contain the n derivatives of y as functions        d:=0:      #Initialize a dummy variable that's going to contain n terms of the taylor series of y (without y[i-1])        for j from 1 to n-1 do:            z[j]:=unapply(diff(z[j-1](Y),Y)*f(Y),Y): #Use Chain rule to compute the j order derivative, use y'=f, and unapply to set them as functions        od:        for m from 0 to n-1 do:            d:=d+(1/(m+1)!)*(h^(m+1))*z[m](y[i-1]): #Add all terms in Taylor series up to order n        od:        y[i]:=y[i-1]+evalf(d):    od:     [[x[0],y[0]],seq([x[l],y[l]],l=1..N)]:end proc:   </Text-field>
</Input>
</Group>
