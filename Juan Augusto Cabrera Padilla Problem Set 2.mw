<Group labelreference="L153" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#We start by writing the Trapezoidal algorithm for a system of ODEs</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L137" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
Y[i]:=Vector[column]([y1[i],y2[i]]);
Y[i+1]:=Vector[column]([y1[i+1],y2[i+1]]);
F(x[i],Y[i]):=Vector[column]([f[1](x[i],y1[i],y2[i]),f[2](x[i],y1[i],y2[i])]);
F(x[i+1],Y[i+1]):=Vector[column]([f[1](x[i+1],y1[i+1],y2[i+1]),f[2](x[i+1],y1[i+1],y2[i+1])]);
Trapezoidal:=1/2*(F(x[i], Y[i]) + F(x[i+1], Y[i+1])) = (-Y[i] + Y[i+1])/h;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
