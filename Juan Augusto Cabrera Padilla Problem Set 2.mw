<Group labelreference="L319" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Leapfrog := proc(y0, N)
    local h, x, y, i:
    h := evalf(5/N):
    x[0] := 0:
    y[0] := y0:
    x[1]:=h:
    y[1]:=y0*(2-h)/(h+2):
    for i from 2 to N do:
        x[i] := x[i-1]+h:
        y[i] := Centered(h, x[i-1], x[i-2],y[i-1],y[i-2]):
    od:
     [seq([x[i], y[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
</Group>
