<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f := (x, y) -&gt; -y^2+2*x;
y0 := 2;
N := 5;
ode := diff(y(x), x) = f(x, y(x));
analytic_sol := rhs(dsolve({ode, y(0) = y0}));

plot([EulerSol(y0, N), RK4Sol(y0, N), analytic_sol], x = 0..1, style = [point$2, line], legend = [`Forward Euler`, `Runge-Kutta 4th order`, `Analytic solution`], axes = boxed);

