<Group labelreference="L404" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">RK4Sol := proc(y0, N)
    local h, x, y, i, k:
    h := evalf(1/N):
    x[0] := 0:
    y[0] := y0:
    for i from 1 to N do:
        x[i] := x[i-1]+h:
        k[1] := K[1](h, x[i-1], y[i-1]):
        k[2] := K[2](h, x[i-1], y[i-1], k[1]):
        k[3] := K[3](h, x[i-1], y[i-1], k[1], k[2]):
        k[4] := K[4](h, x[i-1], y[i-1], k[1], k[2], k[3]):
        y[i] := K[5](h, x[i-1], y[i-1], k[1], k[2], k[3], k[4]):
    od:
    [seq([x[i], y[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
</Group>
<Group labelreference="L485" drawlabel="true">
<Input><Text-field style="Text" layout="Normal">We will compare the fourth order Runge-Kutta results with those obtained by the forward Euler stencil as calculated by <Font style="Maple Input" executable="false">EulerSol</Font>.</Text-field>
</Input>
</Group>
<Group labelreference="L440" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">EulerSol := proc(y0, N)
    local h, x, y, i:
    h := evalf(1/N):
    x[0] := 0:
    y[0] := y0:
    for i from 1 to N do:
        x[i] := x[i-1]+h:
        y[i] := y[i-1]+h*f(x[i-1], y[i-1]):
    od:
    [seq([x[i], y[i]], i = 0..N)]:
end proc:</Text-field>
</Input>
</Group>
<Group labelreference="L483" drawlabel="true">
<Input><Text-field style="Text" layout="Normal">Here is a plot of the output generated by the two stencils compare to the analytic solution of the equation for a particular choice of <Equation executable="false" style="2D Math" input-equation="" display=""></Equation>.</Text-field>
