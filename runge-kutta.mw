</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+Jkkma19kZWZHRig2IyIiIi8mSSJrR0YoRi8tSSJmR0YoNiQmSSJ4R0YoNiNJImlHRigmSSJ5R0YoRjk3I0Yx</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+Jkkma19kZWZHRig2IyIiIy8mSSJrR0YoRi8tSSJmR0YoNiQsJiomSSJoR0YoIiIiJkkiY0dGKEYvRjpGOiZJInhHRig2I0kiaUdGKEY6LCYqKEY5RjomSSZhbHBoYUdGKDYkRjBGOkY6JkYzNiNGOkY6RjomSSJ5R0YoRj9GOjcjRjE=</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSdldm9sdmVHRigvJkkieUdGKDYjLCZJImlHRigiIiJGNEY0LCYmRjA2I0YzRjQqJkkiaEdGKEY0LCYqJiZJImJHRig2I0Y0RjQmSSJrR0YoRj5GNEY0KiYmRj02IyIiI0Y0JkZARkNGNEY0RjRGNDcjRi4=</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L496" drawlabel="true">
<Input><Text-field style="Text" layout="Normal">It would be useful to have a set indicating what we want to solve for.</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L493" drawlabel="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">unknowns := {seq(seq(alpha[n, m], m = 1..n-1), n = 2..M), seq(b[n], n = 1..M), seq(c[n], n = 2..M)};</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSl1bmtub3duc0dGKDwmJkkmYWxwaGFHRig2JCIiIyIiIiZJImJHRig2I0YzJkY1NiNGMiZJImNHRihGODcjRi4=</Equation></Text-field>
